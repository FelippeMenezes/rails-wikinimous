<div class="container d-flex flex-column align-items-center mt-4 w-50">
    <div>
        <div class="d-flex align-items-center">
            <h1 class="me-3"><%= @article.title %></h1>
            <%= link_to edit_article_path(@article), class: "text-decoration-none" do %>
                <i class="fa-solid fa-pencil fa-xl"></i>
            <% end %>
            <%= link_to article_path(@article), class: "ms-2", data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } do %>
                <i class="fa-regular fa-trash-can fa-xl"></i>
            <% end %>
        </div>
        <hr>
        <p><%= @article.content %></p>
    </div>
</div>