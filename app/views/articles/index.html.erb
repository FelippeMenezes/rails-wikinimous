<div class="container d-flex flex-column align-items-center mt-4 my-1">
  <ul class="list-unstyled w-50">
    <% @articles.each do |article| %>
      <h3><%= link_to article.title, article_path(article), class: "text-decoration-none" %></h3>
      <p><%= truncate(article.content, length: 64) %></p>
    <% end %>
  </ul>
</div>